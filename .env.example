# ==============================================================================
#  iOpenbackup - Variáveis de Ambiente Opcionais (.env)
# ==============================================================================

# Porta da Dashboard de Controle Central (Padrão: 8000)
PORT=8000

# Fuso Horário dos Serviços
TZ=America/Sao_Paulo

# Credenciais Iniciais de Rede Samba SMB (iOS Arquivos)
SMB_USER=backupuser
SMB_PASS=backup123
SMB_SHARE=iCloud-Backup
