# ==============================================================================
#  iOpenbackup - Variáveis de Ambiente Opcionais (.env)
# ==============================================================================

# Porta externa do iOpDash no Host (Padrão: 8000). Caso a 8000 esteja em uso no servidor, mude para 8008 ou 8080.
HOST_PORT=8000
PORT=8000

# Fuso Horário dos Serviços
TZ=America/Sao_Paulo

# Credenciais Iniciais de Rede Samba SMB (iOS Arquivos)
SMB_USER=backupuser
SMB_PASS=backup123
SMB_SHARE=iCloud-Backup

# Perfis de Servicos Docker Compose:
# Por padrao, apenas o nucleo leve (iCloud Sync + Samba SMB) eh iniciado.
# Para ativar a galeria Immich AI Photos no Dokploy ou VPS, descomente a linha abaixo:
# COMPOSE_PROFILES=immich
